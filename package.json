{
  "name": "restaurant-kit",
  "version": "0.1.0",
  "description": "Shared restaurant site kit: public menu browser, WhatsApp cart, admin menu CMS, and Cloudflare Worker API.",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "scripts"
  ],
  "bin": {
    "restaurant-kit-hash-password": "./scripts/hash-admin-password.mjs",
    "restaurant-kit-bootstrap": "./scripts/bootstrap-site.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/types/worker/index.d.ts",
      "import": "./dist/worker.js"
    },
    "./styles.css": "./dist/restaurant-kit.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly --noEmit false --outDir dist/types --tsBuildInfoFile node_modules/.tmp/tsconfig.types.tsbuildinfo",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "lucide-react": "^0.468.0",
    "react-image-crop": "^11.1.2",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.30.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "4.1.9"
  }
}
